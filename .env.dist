# Default environment. Copy to .env for local development (`cp .env.dist .env`);
# the Docker image ships this file as its .env. Variables already set in the
# environment (e.g. `docker run -e ...`) take precedence over values here.
# Never put real secrets in this file: it is committed and baked into the image.

# HTTP port for `npm start` (the production server). `npm run dev` uses Vite's port.
PORT=3000

# OpenAI-compatible endpoint of the Ollama server the agents' model runs on.
OLLAMA_BASE_URL=http://ollama:11434/v1

# Whappr WhatsApp gateway. Both are required: the server refuses to start
# while either is empty.
WHAPPR_GATEWAY_URL=
WHAPPR_SECRET_KEY=
