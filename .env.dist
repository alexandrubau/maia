# Default environment. Copy to .env for local development (`cp .env.dist .env`);
# the Docker image ships this file as its .env. Variables already set in the
# environment (e.g. `docker run -e ...`) take precedence over values here.
# Never put real secrets in this file: it is committed and baked into the image.

# HTTP port for `npm start` (the production server). `npm run dev` uses Vite's port.
PORT=3000

# OpenAI-compatible endpoint of the Ollama server the agents' model runs on.
OLLAMA_BASE_URL=http://ollama:11434/v1

# Whappr WhatsApp gateway. Both are required: the server refuses to start
# while either is empty.
WHAPPR_GATEWAY_URL=
WHAPPR_SECRET_KEY=

# The people who may put Maia in a WhatsApp group: she leaves a group unless one of
# them added her (or, when WhatsApp doesn't say who did, is a member), and once none
# of them is left in it. Comma-separated ids (…@c.us, …@lid) or phone numbers, like
# the gateway's WEBHOOK_SENDER_IDS. Required: the server refuses to start without one.
# The gateway must send group.joined and group.participant.left (WEBHOOK_EVENT_TYPES)
# for every chat (WEBHOOK_CHAT_IDS empty), or Maia only notices at her next start.
WHAPPR_TRUSTED_IDS=

# Database for conversations and sessions. Only sqlite:// is supported for now;
# the path is relative to the working directory. Defaults to the value below.
# DATABASE_URL=sqlite://./data/flue.db

# Minimum log level: trace, debug, info, warn, error, fatal or silent. Logs are JSON
# lines on stdout, pretty-printed instead when NODE_ENV is not "production".
LOG_LEVEL=info
